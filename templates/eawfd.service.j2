[Unit]
Description=eawf coordinator daemon (eawfd)
After=default.target

[Service]
Type=simple
ExecStart={{ eawfd_argv | join(' ') }} --foreground
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment="EAWF_RUNTIME_DIR={{ runtime_dir }}"
Environment="PATH={{ service_path }}"

[Install]
WantedBy=default.target
