{"scenario": "request-only", "control": "cancel", "acknowledge": null, "effect": null, "expected_disposition": "requesting", "expected_status": "RUNNING", "expected_cursor": 1, "note": "a request is an ask, not an outcome; the Run is untouched"}
{"scenario": "accepted-never-effected", "control": "cancel", "acknowledge": "accepted", "effect": null, "expected_disposition": "accepted", "expected_status": "RUNNING", "expected_cursor": 2, "note": "the lost acknowledgement: the daemon holds the request and nothing was observed"}
{"scenario": "cancel-confirmed", "control": "cancel", "acknowledge": "accepted", "effect": "confirmed", "expected_disposition": "confirmed", "expected_status": "CANCELLED", "expected_cursor": 3, "note": "a confirmed effect is the only fact that terminalizes"}
{"scenario": "interrupt-confirmed", "control": "interrupt", "acknowledge": "accepted", "effect": "confirmed", "expected_disposition": "confirmed", "expected_status": "CANCELLED", "expected_cursor": 3, "note": "interrupt stops the episode on the same terms as cancel"}
{"scenario": "cancel-unknown", "control": "cancel", "acknowledge": "accepted", "effect": "unknown", "expected_disposition": "unknown", "expected_status": "RUNNING", "expected_cursor": 3, "note": "transport failed after submission; the effect is genuinely undetermined"}
{"scenario": "cancel-recovery", "control": "cancel", "acknowledge": "accepted", "effect": "recovery", "expected_disposition": "recovery", "expected_status": "RUNNING", "expected_cursor": 3, "note": "reconciliation is exhausted and the decision is handed back to the operator"}
{"scenario": "cancel-rejected", "control": "cancel", "acknowledge": "rejected", "effect": null, "expected_disposition": "rejected", "expected_status": "RUNNING", "expected_cursor": 2, "note": "the daemon refused the request; the Run returns to its prior state"}
{"scenario": "cancel-invalidated", "control": "cancel", "acknowledge": "invalidated", "effect": null, "expected_disposition": "invalidated", "expected_status": "RUNNING", "expected_cursor": 2, "note": "the proof the request was bound to changed under it"}
{"scenario": "steer-confirmed", "control": "steer", "acknowledge": "accepted", "effect": "confirmed", "expected_disposition": "confirmed", "expected_status": "RUNNING", "expected_cursor": 3, "note": "a confirmed effect of a control that ends no Run moves no status"}
