    publishing --> recovering: recovery_opened [none]
    publish_timeout --> publishing: publication_retried [idempotent_retry]
    publish_timeout --> recovering: recovery_opened [none]
    verifying --> baked: baked [observed_prerelease]
    verifying --> released: released [observed_stable]
