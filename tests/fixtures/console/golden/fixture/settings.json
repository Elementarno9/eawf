 "DOC": {
  "audit.default_level": [
   "how wide the default /audit check plan runs",
   "quick narrows to a smoke set · standard is the full default set · deep is the widest"
  ],
  "audit.default_checks": [
   "the checks /audit runs when none are named"
  ],
  "audit.flaky_retry_count": [
   "how often a flaky check is retried before it counts as failed"
  ],
  "cli.canonical_command": [
   "the command name the docs and errors use"
  ],
  "cli.install_aliases": [
   "extra shell aliases installed beside the canonical command"
  ],
  "config.layers_visible": [
   "show which layer contributed each value in eawf config get"
  ],
  "daemon.idle_timeout_seconds": [
   "how long the daemon stays resident with nothing to do"
  ],
  "daemon.proxy_enabled": [
   "route runtime calls through the daemon rather than per process"
  ],
  "dispatch.session_policy_default": [
   "whether a dispatch reuses an agent session or starts clean",
   "fresh starts a new session · reuse keeps the handle · ask decides per dispatch"
  ],
  "dispatch.role_tier_token_cap": [
   "the token ceiling one role-tier block may weigh before dispatch refuses"
  ],
  "docs.generation_policy": [
   "whether generated docs are written without asking"
  ],
  "estimation.enabled": [
   "whether work carries estimates at all"
  ],
  "estimation.eu_minutes": [
   "how many minutes one estimation unit is worth"
  ],
  "estimation.eu_basis": [
   "what an estimate is measured against",
   "api_duration counts agent API time · wall_clock counts elapsed time"
  ],
  "estimation.idle_policy": [
   "what counts as idle and is excluded from an estimate",
   "D30_non_agent_gap treats a gap over 30s with no agent activity as idle"
  ],
  "estimation.realtime_recalibration": [
   "re-fit estimates while work runs rather than after"
  ],
  "estimation.display.eu_quantum": [
   "the smallest estimation-unit step a display will show"
  ],
  "estimation.buckets.n_min": [
   "the fewest samples a bucket needs before it reports at all"
  ],
  "estimation.buckets.high_confidence_n": [
   "the sample count at which a bucket is called high confidence"
  ],
  "flow.budget.enforce": [
   "what happens when a wave passes its token budget",
   "soft warns and lets it continue · hard halts it at the cap via SIGTERM then SIGKILL"
  ],
  "flow.budget.multiplier": [
   "how much headroom the enforced cap adds over the base budget"
  ],
  "flow.max_repair_cycles": [
   "stop re-entering a failing flow stage past this many repair cycles"
  ],
  "flow.advance_after.research": [
   "authorise advancing automatically once research completes"
  ],
  "flow.advance_after.prep": [
   "authorise advancing automatically once prep completes"
  ],
  "language.runtime": [
   "the language runtime a scope is built and tested against"
  ],
  "mcp.default_policy": [
   "whether an MCP server may be installed without asking"
  ],
  "mcp.manage_only_owner": [
   "only touch MCP entries this owner wrote, never a hand-edited one"
  ],
  "memory.stores": [
   "which memory stores are read and written"
  ],
  "memory.auto_promote": [
   "whether a finding is promoted into a durable store without asking"
  ],
  "memory.max_injected_tokens": [
   "the ceiling on memory injected into an agent prompt"
  ],
  "planning.approval": [
   "who authorises a plan before it dispatches",
   "ask stops for you · auto dispatches the plan · never refuses to dispatch at all"
  ],
  "planning.max_parallel_waves": [
   "how many waves may run at once"
  ],
  "planning.require_research_for_unknowns": [
   "refuse to plan over an unknown until it is researched"
  ],
  "planning.auto_plan": [
   "skip the plan proposal and dispatch inline",
   "false enters plan mode and shows the wave DAG before any state mutation"
  ],
  "preferences.solution_bias": [
   "how adventurous a proposed solution should be"
  ],
  "preferences.scope_size": [
   "the default size a new scope is cut to"
  ],
  "preferences.auto_choose": [
   "whether the planner answers its own questions",
   "off always asks · safe answers only reversible questions · all answers everything"
  ],
  "prep.auto_resume": [
   "lead /prep with a dispatch resume so a leaked pause cannot reject the batch"
  ],
  "profiles.enabled": [
   "which profiles compose the active behaviour, in order"
  ],
  "profiles.conflict_resolution": [
   "what happens when two profiles set the same thing",
   "prompt asks · strictest_wins takes the tighter value · first_wins takes profile order"
  ],
  "profiles.safety_policy": [
   "how safety settings combine across profiles — tightening only"
  ],
  "project.code": [
   "the short project token that prefixes every task id"
  ],
  "prose.level": [
   "the doc-clarity strictness floor",
   "a layer may tighten this floor, never loosen it — a looser value is stored and inert"
  ],
  "prose.clarity_judge": [
   "run the clarity judge · unset defers to the level"
  ],
  "research.default_depth": [
   "how deep a research pass goes by default"
  ],
  "research.default_sources": [
   "where research reads from"
  ],
  "research.agent_count": [
   "how many agents a research pass fans out to"
  ],
  "review.default_level": [
   "how thorough a review is by default"
  ],
  "review.require_checks_before_approve": [
   "refuse an approval until the checks are green"
  ],
  "runtime.default": [
   "which runtime a dispatch uses when none is named"
  ],
  "runtime.preference": [
   "failover order — the first healthy runtime wins"
  ],
  "runtime.fallback.enabled": [
   "fail over to the next runtime rather than stopping"
  ],
  "security.secrets_policy": [
   "how secrets may be referenced",
   "env_refs_only permits only environment references · inline_forbidden also blocks literals"
  ],
  "security.permission_mode": [
   "what an agent may do without asking",
   "ask_first stops for permission · allow proceeds · deny refuses"
  ],
  "security.secret_scan": [
   "scan for secrets before they can be written"
  ],
  "security.store_scan_on_finding": [
   "what a secret found in a store does",
   "block refuses the write · warn records it · ignore proceeds"
  ],
  "security.allow_destructive": [
   "whether a destructive action may run without asking"
  ],
  "ship.gauntlet": [
   "how much of the ship gauntlet runs",
   "full runs every gate, mandatory for migration waves and iter close · scoped is legal only for re-runs"
  ],
  "ship.use_vcs_policy": [
   "apply the vcs policy when shipping rather than shipping bare"
  ],
  "state_schema.id_padding": [
   "how many digits an entity id is padded to"
  ],
  "statusline.modules_default": [
   "which statusline modules are on without asking"
  ],
  "storage.commit_jsonl": [
   "which event journals are committed to the repository"
  ],
  "storage.content_addressed_blobs": [
   "store blobs by content hash, so an identical artifact is stored once"
  ],
  "storage.max_inline_chars": [
   "the size at which a value spills to a blob instead of storing inline"
  ],
  "storage.lock_strategy": [
   "how concurrent writers are kept from colliding"
  ],
  "telemetry.enabled": [
   "collect local telemetry · nothing leaves the machine either way"
  ],
  "ui.color": [
   "whether colour is used",
   "auto follows the terminal · always forces it · never renders severity by glyph alone"
  ],
  "ui.glyphs": [
   "which glyph set the frames draw with",
   "auto follows the terminal · unicode uses sigils · ascii uses their ASCII twins"
  ],
  "ui.refresh_ms": [
   "how often a live frame re-renders"
  ],
  "ui.bare_command": [
   "what the bare command opens with no arguments"
  ],
  "vcs.protected_branches": [
   "branches that may never be force-pushed or deleted"
  ],
  "vcs.auto_commit": [
   "whether a checkpoint commits without asking"
  ],
  "vcs.force_push": [
   "when a force push is permitted",
   "forbidden_protected allows it except on protected branches · forbidden never · allowed always"
  ],
  "vcs.checkpoint_requires_commit": [
   "refuse a checkpoint that is not backed by a commit"
  ],
  "vcs.require_ci_green": [
   "refuse a merge while CI is not green"
  ],
  "vcs.require_review_before_merge": [
   "refuse a merge that no one has reviewed"
  ],
  "vcs.branch_pattern": [
   "the pattern new branches are named from"
  ],
  "vcs.coauthor.mode": [
   "how the co-author trailer is chosen",
   "runtime uses the runtime that did the work · fixed uses one name · off writes none"
  ],
  "verify.juror_wall_clock_seconds": [
   "how long a juror may take before it is abandoned"
  ],
  "verify.odr_blocking": [
   "let the Oracle-Determinism-Ratio floor refuse an iter close",
   "this ORs onto the profile block — a layer can tighten it, never loosen it"
  ],
  "verify.waiver_mode": [
   "which waiver regime applies to a failed gate"
  ],
  "workspace.enabled": [
   "treat several repositories as one workspace"
  ],
  "worktrees.enabled": [
   "whether risky or parallel work runs in a separate worktree",
   "auto decides per wave · always isolates every wave · never works in place"
  ],
  "worktrees.merge_mode": [
   "how a worktree comes back",
   "cherry_pick replays commits · merge joins the branch · rebase moves it onto the base"
  ],
  "worktrees.preserve_on_conflict": [
   "keep a conflicted worktree rather than removing it"
  ]
