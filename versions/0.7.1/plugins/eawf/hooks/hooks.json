{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/pre_tool_use.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/session_end.sh\"",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/session_start.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/subagent_start.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/subagent_stop.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
