  "findings": [
    {
      "id": "F-01",
      "known_gap": false,
      "observed": "/verify --mode all was refused with schema_validation_failed on actor, while the same verb called with an operator principal reached its domain check",
      "severity": "P1",
      "statement": "/verify and /dispatch present their own skill name in the actor parameter of the verification and retry verbs, and that parameter is typed to a principal key, so neither call can be accepted whatever the tree holds"
    },
    {
      "id": "F-02",
      "known_gap": false,
      "observed": "the census derives campaign, claim, evidence, health_view, release and sandbox_policy as producerless, and the declaration names pending_action alone",
      "severity": "P2",
      "statement": "six collections a console route reads have no epoch-2 producer and are not named by the unwritten-register declaration, so those routes draw an empty register as one that was read and found quiet"
    },
    {
      "id": "F-03",
      "known_gap": false,
      "observed": "/integrate show over the freshly applied Batch reported one record and one conflict frame and returned outcome conflicted on a blocked envelope",
      "severity": "P2",
      "statement": "the merge-conflict route is bound to the batch collection, so a Batch that has received no delivery renders as one conflict frame and /integrate show reports the Batch as conflicted"
    },
    {
      "id": "F-04",
      "known_gap": true,
      "observed": "the census records pending_action with no producer, and the code's own unwritten-register declaration names it",
      "severity": "P1",
      "statement": "accepting a Milestone requires a sealed pending action and nothing in epoch 2 writes one, so the acceptance edge is unreachable even from acceptance review"
    },
    {
      "id": "F-05",
      "known_gap": true,
      "observed": "planning.plan_revision.submit refused with identity_not_found on the guard primary_track_resolved until the rows were seeded",
      "severity": "P2",
      "statement": "no shipped verb admits a Track or a repository row into an epoch-2 tree, so a plan cannot be submitted against a canary without a direct document write"
    }
  ],
