  "defects": [
    {
      "code": "migration_not_quiescent",
      "fix": "src/eawf/kernel/migration/epoch2/quiescence.py: a zero-byte lease no process holds is released and passes; a lease with a holder record, or an empty one still locked, still refuses",
      "id": "D-01",
      "status": "fixed",
      "summary": "the quiescence probe counted every *.lock file under .ea/locks as a held lease, but the lock primitive keeps its inode and empties it on release, so any tree that ever took the worktree or plugin-sync lock refused the cutover forever"
    },
    {
      "id": "D-02",
      "status": "open",
      "summary": "the apply builds the generation from the staged HEAD corpus and re-censuses only that snapshot; nothing compares it with the live document, so state written after the last state commit (here: 37 reconciled worktrees, session sweeps by the daemon) is silently absent from the generation while the restore point still carries it"
    },
    {
      "id": "D-03",
      "status": "open",
      "summary": "a migration_not_quiescent refusal suggests 'run eawf validate to inspect schema errors', which does not clear any holder"
    },
    {
      "id": "D-04",
      "status": "open",
      "summary": "the refusal names at most 20 holders; clearing 37 managed-worktree rows took the worktree reconcile verb, which the refusal does not name"
    }
  ],
