/* Textual theme for the Eä TUI rebuild (tui_v2).
 *
 * Defines the semantic colour vars consumed by every tui_v2 widget +
 * screen ($ok/$warn/$err/$muted/$accent/$primary) and the base layout
 * for the scope screens. Runtime theme swap (/theme dark|light|auto)
 * rebinds these vars at the App level in a later wave; this file is the
 * default dark palette. Colours follow the Wong 2011 deuteranopia-safe
 * set so the colour-blind palette swap stays a var rebind, not a layout
 * change.
 */

/* --- semantic colour vars (dark default) --- */
$accent: #56b6c2;
$primary: #56b6c2;
$ok: #009e73;
$warn: #e69f00;
$err: #d55e00;
$muted: #6c6c6c;

/* --- lifecycle-status glyph tints (additive on top of the V12 glyph) ---
 * The roadmap tree tints each row's leading status glyph by lifecycle
 * status from the Wong deuteranopia-safe set. Tree node labels are
 * Rich-parsed and cannot resolve these vars, so the tree mirrors the same
 * hex values in roadmap_tree.STATUS_COLOURS; these vars are the canonical
 * palette home (any other surface that wants a status tint binds them).
 */
$status-pending: #6c6c6c;
$status-claimed: #56b6c2;
$status-in-progress: #e69f00;
$status-closed: #009e73;
$status-failed: #d55e00;

Screen {
    background: $surface;
    color: $text;
}

/* --- header: Eä brand outside-left of the scope breadcrumb ---
 * Brand accent + runtime/clock cell colours are carried inline by the
 * Header widget's content markup ($accent / $muted) so the runtime
 * theme swap stays a palette-var rebind; the dock + background live in
 * the widget DEFAULT_CSS and are restated here for the global default.
 */
Header {
    height: 1;
    dock: top;
    background: $panel;
    color: $text;
}

/* --- footer: context key hints (full key names) + heartbeat dot --- */
Footer {
    height: 1;
    dock: bottom;
    background: $panel;
    color: $muted;
}

Footer .footer-hints {
    color: $muted;
}

/* --- heartbeat: accent pulse, err when any pane degraded --- */
Heartbeat {
    color: $accent;
}

Heartbeat.-degraded {
    color: $err;
}

/* --- scope-screen body shell (shared by every scope screen) --- */
#body {
    height: 1fr;
}

/* --- quadrant / strip rows + bordered panes (RepoScreen / WorkspaceScreen) --- */
.row {
    height: 1fr;
}

.pane {
    width: 1fr;
    height: 1fr;
    border: solid $accent;
    padding: 0 1;
}

.pane.-focused {
    border: solid $primary;
}

.pane-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

/* --- UserScreen weighted sections (attention 3 : effort 2 : portfolio 5) --- */
.section {
    width: 1fr;
    border: solid $accent;
    padding: 0 1;
}

#attention {
    height: 3fr;
}

#effort {
    height: 2fr;
}

#portfolio {
    height: 5fr;
}

.section-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

/* --- degraded banner (mtime-poll fallback active) --- */
.degraded-banner {
    height: 1;
    dock: top;
    background: $err;
    color: $text;
    text-style: bold;
}
