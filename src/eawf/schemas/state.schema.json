        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AuditStatus"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "scope_id",
        "kind",
        "status",
        "created_at"
      ],
      "title": "Audit",
      "type": "object"
    },
    "AuditKind": {
      "enum": [
        "evaluation",
        "ship-gate",
        "incident",
        "review"
      ],
      "title": "AuditKind",
      "type": "string"
    },
    "AuditStatus": {
      "enum": [
        "pending",
