    "Hypothesis": {
      "additionalProperties": false,
      "description": "Research hypothesis with confirm/reject thresholds.",
      "properties": {
        "audit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Id"
        },
        "confirm": {
          "title": "Confirm",
          "type": "string"
        },
        "id": {
          "pattern": "^(?:H\\d{2}-\\d{2}|[A-Z][A-Z0-9_-]{1,15}-H\\d{2}-\\d{2})$",
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "reject": {
          "title": "Reject",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "source_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Artifact Id"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus"
