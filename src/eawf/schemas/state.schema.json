{
  "$defs": {
    "ActualStatus": {
      "enum": [
        "planned",
        "active",
        "done",
        "interrupted",
        "blocked",
        "abandoned",
        "failed",
        "superseded"
      ],
      "title": "ActualStatus",
      "type": "string"
    },
    "ActualSummary": {
      "additionalProperties": false,
      "description": "Latest actual (segments in store).",
      "properties": {
        "agent_runtime_eu": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Runtime Eu"
        },
        "attention_eu": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attention Eu"
        },
        "current_store_record_id": {
          "title": "Current Store Record Id",
          "type": "string"
        },
        "elapsed_eu": {
          "title": "Elapsed Eu",
          "type": "number"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ActualStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope_id",
        "status",
        "elapsed_eu",
        "current_store_record_id",
        "updated_at"
      ],
      "title": "ActualSummary",
      "type": "object"
    },
    "AgentSession": {
      "additionalProperties": false,
      "description": "Agent work session for provenance.",
      "properties": {
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "claimed_wave_ids": {
          "items": {
            "pattern": "^P\\d{2}-I\\d{2}-W\\d{2}$",
            "type": "string"
          },
          "title": "Claimed Wave Ids",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentSessionRole"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentSessionStatus"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "worktree_ids": {
          "items": {
            "type": "string"
          },
          "title": "Worktree Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "role",
        "runtime",
        "scope_id",
        "status",
        "started_at"
      ],
      "title": "AgentSession",
      "type": "object"
    },
    "AgentSessionRole": {
      "enum": [
        "researcher",
        "planner",
        "executor",
        "auditor",
        "reviewer",
        "polisher",
        "operator",
        "domain-specialist"
      ],
      "title": "AgentSessionRole",
      "type": "string"
    },
    "AgentSessionStatus": {
      "enum": [
        "active",
        "checkpointed",
        "closed",
        "stale",
        "failed"
      ],
      "title": "AgentSessionStatus",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "description": "Tracked artifact (file/blob/external).",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "urn": {
          "pattern": "^urn:eawf:v1:(artifact|blob|branch|commit|pr|repo|secret|state|store|workspace):[^:?#/]+(?:/[^?#]*)?(?:\\?=[^#]*)?(?:#.*)?$",
          "title": "Urn",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "urn",
        "created_at"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Audit": {
      "additionalProperties": false,
      "description": "Audit record (evaluation, ship-gate, incident, review).",
      "properties": {
        "check_results": {
          "items": {},
          "title": "Check Results",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "integrity_results": {
          "items": {},
          "title": "Integrity Results",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/AuditKind"
