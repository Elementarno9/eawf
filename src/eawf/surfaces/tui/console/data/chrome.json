  "reads": {
   "LIVE": "full — every aggregate is complete",
   "LIVE / PARTIAL": "complete where labelled; partial aggregates say so",
   "REPLAYING": "cached facts plus replay progress",
   "GAP DETECTED": "no all / none / complete claim for the range",
   "SNAPSHOT LOADING": "the previous revision, labelled with its own age",
   "OFFLINE SNAPSHOT": "inspect, navigate and copy all work",
   "DEGRADED": "everything except cost, which renders ∅ unavailable"
  },
  "refuse": {
   "SNAPSHOT REQUIRED": "there is no usable revision — the frame names the repair, not a retry",
   "LIVE": "",
   "LIVE / PARTIAL": "the aggregate is incomplete",
   "REPLAYING": "a replay is in progress",
   "GAP DETECTED": "reconcile the gap first",
   "SNAPSHOT LOADING": "the snapshot is still loading",
   "OFFLINE SNAPSHOT": "the daemon cannot be reached",
   "DEGRADED": "not in the certified-safe subset"
  },
  "muts": {
   "LIVE": "allowed by action and capability policy",
   "LIVE / PARTIAL": "only actions unrelated to the incomplete aggregates",
   "REPLAYING": "exact-revision actions disabled",
   "GAP DETECTED": "reconcile first",
   "SNAPSHOT LOADING": "disabled while in flight",
   "OFFLINE SNAPSHOT": "gone — absent rather than present-and-failing",
   "DEGRADED": "the certified-safe subset only"
  },
