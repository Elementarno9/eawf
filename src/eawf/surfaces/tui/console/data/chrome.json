    "refuse a merge that no one has reviewed"
   ],
   "vcs.branch_pattern": [
    "the pattern new branches are named from"
   ],
   "vcs.coauthor.mode": [
    "how the co-author trailer is chosen",
    "runtime uses the runtime that did the work · fixed uses one name · off writes none"
   ],
   "verify.juror_wall_clock_seconds": [
    "how long a juror may take before it is abandoned"
   ],
   "verify.odr_blocking": [
    "let the Oracle-Determinism-Ratio floor refuse an iter close",
    "this ORs onto the profile block — a layer can tighten it, never loosen it"
   ],
   "verify.waiver_mode": [
    "which waiver regime applies to a failed gate"
   ],
   "workspace.enabled": [
    "treat several repositories as one workspace"
   ],
   "worktrees.enabled": [
    "whether risky or parallel work runs in a separate worktree",
    "auto decides per wave · always isolates every wave · never works in place"
   ],
   "worktrees.merge_mode": [
    "how a worktree comes back",
    "cherry_pick replays commits · merge joins the branch · rebase moves it onto the base"
   ],
   "worktrees.preserve_on_conflict": [
    "keep a conflicted worktree rather than removing it"
   ]
