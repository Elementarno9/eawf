{#- Claude Code SKILL.md template. Variables: skill_name, description,
   argument_hint, user_invocable, disable_model_invocation, body. The
   wrapper renderer (`eawf.surfaces.render.skills.render_skill_md`) supplies all
   six. The trailing newline is intentional so end-of-file-fixer is a
   no-op. -#}
---
name: {{ skill_name }}
description: {{ description }}
argument-hint: "{{ argument_hint }}"
user-invocable: {{ "true" if user_invocable else "false" }}
disable-model-invocation: {{ "true" if disable_model_invocation else "false" }}
---

{{ body }}
